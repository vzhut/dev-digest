+/* ColumnsView — the agents side by side. Up to MAX_FIT_COLUMNS share the width; more scroll. */
+"use client";
+
+import React from "react";
+import { MAX_FIT_COLUMNS, SCROLL_COLUMN_WIDTH } from "../../constants";
+import type { RunColumn } from "../../types";
+import { AgentColumn } from "./_components/AgentColumn";
+import { s } from "./styles";
+
+export function ColumnsView({
+  columns,
+  ranAt,
+  now,
+  onSettled,
+  onViewTrace,
+}: {
+  columns: RunColumn[];
+  ranAt: string;
+  now: number;
+  onSettled: () => void;
+  onViewTrace: (runId: string) => void;
+}) {
+  const scrolls = columns.length > MAX_FIT_COLUMNS;
+  return (
+    <div style={s.row(scrolls)}>
+      {columns.map((c) => (
+        <AgentColumn
+          key={c.run_id}
+          column={c}
+          ranAt={ranAt}
+          now={now}
+          fixedWidth={scrolls ? SCROLL_COLUMN_WIDTH : undefined}
+          onSettled={onSettled}
+          onViewTrace={onViewTrace}
+        />
+      ))}
+    </div>
+  );
+}
