+/* AgentMeta — status, time and cost of one agent's run (shared by the column and the tab). */
+"use client";
+
+import React from "react";
+import { useTranslations } from "next-intl";
+import { Badge } from "@devdigest/ui";
+import { formatDuration } from "@/lib/eval-format";
+import { formatCostUsd } from "@/lib/format-cost";
+import { elapsedMs, type DisplayStatus } from "../../helpers";
+import type { RunColumn } from "../../types";
+import { STATUS_COLOR } from "./constants";
+import { s } from "./styles";
+
+export function AgentMeta({
+  column,
+  status,
+  ranAt,
+  now,
+}: {
+  column: RunColumn;
+  status: DisplayStatus;
+  ranAt: string;
+  now: number;
+}) {
+  const t = useTranslations("multiAgent.results");
+  const live = status === "queued" || status === "running";
+  const time = live ? formatDuration(elapsedMs(ranAt, now)) : formatDuration(column.duration_ms);
+  return (
+    <div style={s.row}>
+      <Badge color={STATUS_COLOR[status]}>{t(`status.${status}`)}</Badge>
+      <span className="tnum" style={s.muted}>
+        {time}
+      </span>
+      <span className="tnum" style={s.muted}>
+        {column.cost_usd == null ? t("costUnknown") : formatCostUsd(column.cost_usd)}
+      </span>
+    </div>
+  );
+}
