+/* AgentColumn — one agent's result: status/time/cost, a live log tail while running, the
+   score ring when done, its findings and View trace. Failed / cancelled show the reason
+   instead of a ring. */
+"use client";
+
+import React from "react";
+import { useTranslations } from "next-intl";
+import { Button, CircularScore, LiveLogStream, SeverityBadge, type Severity } from "@devdigest/ui";
+import { LOG_TAIL_HEIGHT } from "../../../../constants";
+import { lineRange } from "../../../../helpers";
+import type { RunColumn } from "../../../../types";
+import { useAgentLive } from "../../../../useAgentLive";
+import { AgentMeta } from "../../../AgentMeta";
+import { s } from "./styles";
+
+export function AgentColumn({
+  column,
+  ranAt,
+  now,
+  fixedWidth,
+  onSettled,
+  onViewTrace,
+}: {
+  column: RunColumn;
+  ranAt: string;
+  now: number;
+  /** Min width in px once the columns scroll; undefined = share the row. */
+  fixedWidth?: number;
+  onSettled: () => void;
+  onViewTrace: (runId: string) => void;
+}) {
+  const t = useTranslations("multiAgent.results");
+  const { status, log, live } = useAgentLive(column, onSettled);
+  const failedOrCancelled = status === "failed" || status === "cancelled";
+
+  return (
+    <section aria-label={column.agent_name} style={s.column(fixedWidth)}>
+      <div style={s.head}>
+        <h3 style={s.name}>{column.agent_name}</h3>
+        {status === "done" && column.score != null && <CircularScore score={column.score} size={44} />}
+      </div>
+      <AgentMeta column={column} status={status} ranAt={ranAt} now={now} />
+
+      {live && <LiveLogStream log={log} running height={LOG_TAIL_HEIGHT} />}
+      {failedOrCancelled && (
+        <p style={s.reason}>{status === "cancelled" ? t("cancelled") : (column.error ?? t("failedNoReason"))}</p>
+      )}
+
+      {status === "done" && (
+        <>
+          <div style={s.count}>{t("findingCount", { count: column.findings.length })}</div>
+          <ul style={s.list}>
+            {column.findings.map((f) => (
+              <li key={f.id} style={s.finding}>
+                <SeverityBadge severity={f.severity as Severity} compact />
+                <div style={s.findingBody}>
+                  <span style={s.findingTitle}>{f.title}</span>
+                  <span className="mono" style={s.findingLoc}>
+                    {f.file}:{lineRange(f.start_line, f.end_line)}
+                  </span>
+                </div>
+              </li>
+            ))}
+          </ul>
+        </>
+      )}
+
+      <Button kind="ghost" size="sm" icon="Eye" onClick={() => onViewTrace(column.run_id)}>
+        {t("viewTrace")}
+      </Button>
+    </section>
+  );
+}
