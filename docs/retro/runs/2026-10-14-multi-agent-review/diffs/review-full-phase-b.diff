+      return {
+        run,
+        currentAgentName: currentAgentName ?? null,
+        review: review ? { verdict: review.verdict, summary: review.summary, score: review.score } : null,
+        findings: review ? (findingsByReview.get(review.id) ?? []) : [],
+      };
+    }),
+  };
+}
