+/* ConflictsSection — "Where agents disagree": one row per contended file:line with the
+   agents' findings there and one cell per agent (flagged / did not flag / failed /
+   cancelled / pending). "Show only conflicts" keeps rows the server marked `is_conflict`. */
+"use client";
+
+import React from "react";
+import { useTranslations } from "next-intl";
+import { SeverityBadge, type Severity } from "@devdigest/ui";
+import { lineRange, takeKind, visibleConflicts } from "../../helpers";
+import type { RunColumn, RunConflict } from "../../types";
+import { s } from "./styles";
+
+export function ConflictsSection({
+  conflicts,
+  columns,
+  onlyConflicts,
+  onToggleOnly,
+}: {
+  conflicts: RunConflict[];
+  columns: RunColumn[];
+  onlyConflicts: boolean;
+  onToggleOnly: (only: boolean) => void;
+}) {
+  const t = useTranslations("multiAgent.results.conflicts");
+  const rows = visibleConflicts(conflicts, onlyConflicts);
+  const nameOf = (agentId: string, fallback: string) =>
+    columns.find((c) => c.agent_id === agentId)?.agent_name ?? fallback;
+
+  return (
+    <section aria-labelledby="multi-agent-conflicts" style={s.wrap}>
+      <div style={s.head}>
+        <h3 id="multi-agent-conflicts" style={s.title}>
+          {t("title")}
+        </h3>
+        <label style={s.toggle}>
+          <input type="checkbox" checked={onlyConflicts} onChange={(e) => onToggleOnly(e.target.checked)} />
+          {t("onlyConflicts")}
+        </label>
+      </div>
+
+      {rows.length === 0 ? (
+        <p style={s.empty}>{onlyConflicts ? t("noneConflicting") : t("none")}</p>
+      ) : (
+        rows.map((c, i) => (
+          <div key={`${c.file}:${c.line}:${i}`} style={s.row}>
+            <div style={s.rowHead}>
+              <span className="mono" style={s.loc}>
+                {c.file}:{lineRange(c.line, c.end_line)}
+              </span>
+              <span style={s.rowTitle}>{c.title}</span>
+            </div>
+            <ul style={s.members}>
+              {c.members.map((m) => (
+                <li key={m.finding_id} style={s.member}>
+                  <span style={s.agent}>{m.agent_name}</span>
+                  <SeverityBadge severity={m.severity as Severity} compact />
+                  <span>{m.title}</span>
+                </li>
+              ))}
+            </ul>
+            <div style={s.cells}>
+              {c.takes.map((take) => {
+                const kind = takeKind(take);
+                return (
+                  <div key={take.agent_id} style={s.cell}>
+                    <div style={s.agent}>{nameOf(take.agent_id, take.persona)}</div>
+                    {kind === "flagged" ? (
+                      <>
+                        <SeverityBadge severity={take.verdict as Severity} compact />
+                        {take.note && <div style={s.note}>{take.note}</div>}
+                      </>
+                    ) : (
+                      <div style={s.note}>{t(`take.${kind}`)}</div>
+                    )}
+                  </div>
+                );
+              })}
+            </div>
+          </div>
+        ))
+      )}
+    </section>
+  );
+}
