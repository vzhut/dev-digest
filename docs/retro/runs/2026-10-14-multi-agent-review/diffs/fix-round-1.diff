@@ -0,0 +1,46 @@
+/**
+ * Pure formatting for the multi-agent review surfaces (PR-page picker, Configure run,
+ * results header). Estimates are history averages per agent; an agent without history
+ * has null numbers and is simply left out of the totals.
+ */
+import type { AgentRunEstimate } from "@devdigest/shared";
+import { formatDuration } from "./eval-format";
+import { UNKNOWN } from "./format-cost";
+
+/** USD with two decimals ("$0.20"); "<$0.01" below a cent; "—" when unknown. Local to the multi-agent surfaces. */
+export function formatCostUsd(n: number | null | undefined): string {
+  if (n == null || !Number.isFinite(n)) return UNKNOWN;
+  if (n > 0 && n < 0.01) return "<$0.01";
+  return `$${n.toFixed(2)}`;
+}
+
+/** Sum of the known (non-null) numbers; null when there are none. */
+export function sumKnown(values: Array<number | null | undefined>): number | null {
+  const known = values.filter((v): v is number => v != null && Number.isFinite(v));
+  return known.length === 0 ? null : known.reduce((a, b) => a + b, 0);
+}
+
+/** Per-agent estimate line: "≈ 12.3s · $0.014", or "no estimate" without history. */
+export function estimateLabel(est: AgentRunEstimate | null | undefined): string {
+  if (!est || (est.est_duration_ms == null && est.est_cost_usd == null)) return "no estimate";
+  return `≈ ${formatDuration(est.est_duration_ms)} · ${formatCostUsd(est.est_cost_usd)}`;
+}
+
+/** Total line under a selection: slowest known agent (parallel), summed known cost. */
+export function formatSelectionTotal(estimates: AgentRunEstimate[]): string {
+  const durations = estimates.map((e) => e.est_duration_ms).filter((v): v is number => v != null);
+  const max = durations.length === 0 ? null : Math.max(...durations);
+  const cost = sumKnown(estimates.map((e) => e.est_cost_usd));
+  return `≈ ${formatDuration(max)} · ${formatCostUsd(cost)} · parallel fan-out`;
+}
+
+/** Run header meta: "3 agents · parallel · 41.2s total · $0.052". */
+export function formatRunMeta(
+  agentCount: number,
+  totalDurationMs: number | null | undefined,
+  costs: Array<number | null | undefined>,
+): string {
+  const noun = agentCount === 1 ? "agent" : "agents";
+  const wall = totalDurationMs == null ? UNKNOWN : formatDuration(totalDurationMs);
+  return `${agentCount} ${noun} · parallel · ${wall} total · ${formatCostUsd(sumKnown(costs))}`;
+}
